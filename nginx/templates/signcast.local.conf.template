server {
    listen 80;
    server_name localhost;

    client_max_body_size 100m;

    location /api/ {
        proxy_pass http://backend:${BACKEND_PORT}/;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location /health {
        proxy_pass http://backend:${BACKEND_PORT}/health;
        include /etc/nginx/snippets/proxy-params.conf;
    }

    location / {
        proxy_pass http://frontend:3000;
        include /etc/nginx/snippets/proxy-params.conf;
    }
}
