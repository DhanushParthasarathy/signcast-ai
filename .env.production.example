COMPOSE_PROJECT_NAME=signcast
DOMAIN=signcast.example.com
PUBLIC_API_BASE_URL=https://signcast.example.com/api
FRONTEND_ORIGIN=https://signcast.example.com
PORT=8000
BACKEND_PORT=8000

POSTGRES_DB=signcast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random-password

NEWS_API_KEY=replace-me
OPENAI_API_KEY=replace-me
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

NEXT_PUBLIC_API_BASE_URL=https://signcast.example.com/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_SIGN_BUCKET=sign-videos
ADMIN_API_TOKEN=replace-with-long-random-admin-token
REQUIRE_PRODUCTION_SECRETS=true

REDIS_CACHE_TTL_SECONDS=300
NEWS_REFRESH_INTERVAL_MINUTES=30
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
FFMPEG_PATH=ffmpeg
SEQUENCE_MAX_RETRIES=3
