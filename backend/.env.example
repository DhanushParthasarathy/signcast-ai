APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/signcast
REDIS_URL=redis://localhost:6379/0
NEWS_API_KEY=your-newsapi-key
OPENAI_API_KEY=optional-openai-api-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
ARTICLE_CACHE_TTL_SECONDS=900
REDIS_CACHE_TTL_SECONDS=300
NEWS_REFRESH_INTERVAL_MINUTES=30
NEWS_DEFAULT_COUNTRY=us
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SIGN_BUCKET=sign-videos
FFMPEG_PATH=ffmpeg
SEQUENCE_MAX_RETRIES=3
ADMIN_API_TOKEN=replace-with-long-random-admin-token
REQUIRE_PRODUCTION_SECRETS=true
